# tvhproxy configuration.
#
# Read by /usr/src/app/tvhProxy.py at startup via python-dotenv.
# All values are also overridable via the compose `environment:` block;
# the compose file uses the ${...} substitutions from .env so editing
# .env on the host and `docker compose restart tvhproxy` is enough.
#
# The default values below assume:
#   - TVH is on 203.0.113.52, port 9981
#   - tvhproxy listens on its own macvlan IP (auto-discovered) on port 5004
#   - tvhproxy authenticates to TVH as the dedicated "tvhproxy" user,
#     which has empty password and is allow-listed to the storage subnet
#     only (see pvr/tvhhdhome_access.json mount below)

# Bind address for the Flask/WSGI HTTP server. 0.0.0.0 = accept on every
# interface inside the container; macvlan gives the container one LAN
# IP, so Jellyfin iOS client reaches it via that IP.
TVH_BINDADDR=0.0.0.0
TVH_PROXY_PORT=5004

# Where TVH's HTTP API lives. tvhproxy fetches the channel list, EPG
# grid, and streams via this URL.
#
# Authentication strategy: a dedicated IP-allowlisted "tvhproxy" account
# lives in TVH's accesscontrol + passwd dirs, mounted from
# ./tvhproxy/etc/<uuid> and ./tvhproxy/passwd/<uuid> at container
# start. The plain-text password below is only valid from the IPs in
# the access entry (storage subnet); if tvhproxy is compromised and
# the container escapes its macvlan, the password alone is not
# sufficient to access TVH — the attacker's IP must also match the
# allow-list.
#
# The plain text and the password2 entry in ./tvhproxy/passwd/ are
# derived from the same secret: rotate them together. Use the helper
# command below to regenerate password2:
#
#   python3 -c "import base64; \
#     print(base64.b64encode(b'TVHeadend-Hide-' + b'<NEW_PASSWORD>').decode())"
#
# Existing 'pete' (admin) and 'user' (streaming) accounts continue
# to work normally — the tvhproxy entry has its own username and
# prefix, so it does not shadow them.
TVH_URL=http://tvhproxy:CHANGEME@203.0.113.52:9981

# User and password extracted from TVH_URL above. tvhProxy.py reads
# these as separate config keys and does NOT parse them out of the
# URL — they must be present as standalone variables. Keep the
# secret the same in both places (rotate them together; see helper
# below for regenerating the obfuscated password2 form).
#
#   python3 -c "import base64; \
#     print(base64.b64encode(b'TVHeadend-Hide-' + b'<NEW_PASSWORD>').decode())"
TVH_USER=tvhproxy
TVH_PASSWORD=CHANGEME

# Public-facing URL advertised via SSDP and /discover.json. Jellyfin
# clients resolve this to discover our emulated HDHomeRun. Override
# ONLY if your LAN IP for tvhproxy is not 203.0.113.70 (see
# LOCAL_IPV4_3 in .env).
TVH_PROXY_URL=http://203.0.113.70:5004

# How many tuners to advertise. tvhproxy does NOT actually allocate
# TVH-side resources up-front — TVH will queue requests when all real
# tuners are busy. Keep this slightly above your real DVB adapter
# count so HDHomeRun-aware clients see a generous pool and don't
# refuse to play back when one tuner is briefly busy.
TVH_TUNER_COUNT=4

# Subscription priority passed to TVH for the proxied stream. 300 is
# the upstream default; lower numbers win when multiple TVH clients
# compete for the same tuner.
TVH_WEIGHT=300

# 1 MiB stream chunks. Good for LAN; lower for weak WiFi.
TVH_CHUNK_SIZE=1048576

# TVH stream profile. "pass" = copy H.264/AAC straight through,
# zero transcoding on TVH side (which is what we want on a Celeron).
TVH_PROFILE=pass

# HDHomeRun device identity. ModelNumber "HDHR5-4DT" is the European
# DVB-T2 dual-tuner box (Connect Quatro) so Jellyfin picks the right
# tuner-type heuristics on its side. FriendlyName is what shows up
# in the client's tuner list.
HDRUN_MODEL=HDHR5-4DT
HDRUN_FRIENDLY_NAME=tvhProxy (Pomo PVR)
HDRUN_FIRMWARE_NAME=hdhomerun_dvbt
HDRUN_FIRMWARE_VERSION=20240703

# Per-instance device ID. Eight hex digits — change this if you ever
# run a second tvhproxy (each must have a unique id, otherwise some
# clients will dedupe them and miss one).
DEVICE_ID=12345678
