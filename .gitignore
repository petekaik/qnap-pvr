# .env — keep this file secret. Never commit it.
.env
.env.local
.env.*
!.env.example

# Runtime data that is created by the containers.
**/tvheadend/config/
**/jellyfin/config/
**/media/
**/transcoder/queue/
**/logs/
*.log
# Channel logos (picons), copied out of the tvheadend image by
# `docker cp` so tvhproxy can serve them over HTTP — see compose.yml.
**/picons/

# Local backups and OS files.
*.bak
*.backup
.DS_Store
Thumbs.db

# Temporary files.
*.tmp
*.swp
*~

# Docker artifacts.
*.tar
*.tar.gz

# TVH upstream source — local build dependency only
tvh-src/

# tvhproxy: TVH access-control + passwd JSON. These carry the proxy
# credential and the LAN allow-list, so they are host state, not source.
# ${DATA}/tvheadend/config/ holds the authoritative copy the container
# actually reads; regenerate the repo copies from .env when installing
# (see the install-script work item in BACKLOG.md).
tvhproxy/etc/
tvhproxy/passwd/

# Python bytecode from local syntax checks.
__pycache__/
*.pyc
