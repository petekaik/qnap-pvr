# Base directory for all PVR data on the Docker host.
# This is mounted into every container.
DATA=/path/to/pvr/data

# Timezone for all containers.
TZ=Europe/Helsinki

# TVHeadend macvlan IPv4 address on the external Docker network (eth1).
# Pick a free address in your macvlan subnet (the subnet you used
# in `docker network create --subnet=...` during quick-start step 3).
LOCAL_IPV4_1=203.0.113.11

# Jellyfin macvlan IPv4 address on the external Docker network (eth1).
# Same subnet as LOCAL_IPV4_1, different host octet.
LOCAL_IPV4_2=203.0.113.53

# tvhproxy macvlan IPv4 address on eth1. Same subnet as LOCAL_IPV4_1/2.
# This is the IP advertised in SSDP discovery so Jellyfin iOS clients
# resolve the emulated HDHomeRun to a real LAN address.
#
# Must lie INSIDE the eth1 macvlan IPRange (203.0.113.64/27), i.e.
# 203.0.113.64–.95. Anything outside that range triggers
# "Address already in use" from the macvlan driver — confirmed during
# 2026-09-13 deployment (203.0.113.56 is already used by another LAN
# device and is also below the macvlan lower bound).
#
# Reserved slots in that /27 (do not reuse):
#   - 203.0.113.65  TVH  (LOCAL_IPV4_1; reserved historical)
#   - 203.0.113.66  Jellyfin (LOCAL_IPV4_2)
#   - 203.0.113.67  openclaw gw
# Free: .68 .69 .70 .71 .72 .73 .74 .75 .76 .77 .78 .79
# Picked .70 — far enough from existing reservations to be easy
# to recognise in DHCP tables and firewall logs.
LOCAL_IPV4_3=203.0.113.70

# pvr-queue-exposer macvlan IPv4 address (port 8765). Reserved
# value 203.0.113.48 (next free in the 203.0.113.20–.63 range,
# see NETWORK.md on the host). Used by the Post-Processing webui
# build (see ~/.hermes/plans/postproc-webui.md). Not consulted
# while the rolled-back state is in effect; the value is
# documented here so it doesn't get re-used by another service.
PVR_EXPOSER_IP=203.0.113.48

# Jellyfin API key (generate from Jellyfin dashboard: Dashboard -> Advanced -> API Keys).
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# Cron schedule for the transcoder container.
# Default: daily at 02:00. During testing you can use "0 * * * *" (every hour).
TRANSCODE_CRON=0 2 * * *

# CC-extract enable flag. Set to "false" to make the
# cc-extract container idle without removing the service from
# compose — useful when the storage CPU is overtaxed (e.g. many
# concurrent transcode jobs) and subtitle extraction would push
# the Celeron over the edge. The container stays up but consumes
# essentially no CPU and ~30MB RAM while disabled. To re-enable,
# flip back to "true" and `docker compose restart cc-extract`.
# Any recordings that finished while disabled are picked up
# automatically when re-enabled (drain runs on container start).
CC_EXTRACT_ENABLED=true

# tvhproxy — TVH → HDHomeRun-protokollaemulaattori. Perustuu
# chkuendig/tvhProxy-forkkiin. Sallii Jellyfin iOS-clientin (ja
# muut HDHomeRun-protokollaa ymmärtävät clientit) löytää TVH:n
# lähiverkossa ilman Jellyfin-palvelinta välikätenä. Vaatii
# toimiakseen käyttäjän TVH:hon (kts. pvr/tvhproxy/). Kommentit
# pois kun TVH-käyttäjä on luotu.
# - TVH_URL=http://tvhproxy:salasana@203.0.113.52:9981
# - TVH_PROXY_URL=http://203.0.113.56:5004
# - LOCAL_IPV4_3=203.0.113.56

# Orphan sidecar cleanup cron schedule. Runs inside both the
# comskip and cc-extract containers. Default "0 4 * * *" =
# 04:00 daily, coinciding with the transcode nightly job so
# the I/O bursts all happen in the same quiet hour. Comskip's
# cleanup-orphans removes .edl/.txt/.sm files whose .ts source
# was deleted by TVH's removal-days sweep. Cc-extract's
# cleanup-orphans does the same for .srt files.
# Override if you want a different schedule, e.g. "0 3 * * *"
# to run an hour earlier. Format: standard 5-field crontab.
CLEANUP_CRON=0 4 * * *

# TVHeadend process UID/GID inside the container.
# The qnap-pvr fork's upstream-style image runs as the in-image
# 'tvheadend' user (UID 100, GID 101 by default). It expects to
# read the bind-mounted ${DATA}/tvheadend/config tree, so the
# matching host uid/gid needs to own (or at least be able to
# read) that directory. LinuxServer.io's PUID/PGID would normally
# handle this via a chown entrypoint, but the fork has none.
# Override in .env if your config tree is owned by something else.
# TVH_PUID=100
# TVH_PGID=101